<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <title>product pagina</title>
</head>

<body>
    <%- include("partials/nav") %>
        <a class="back" href="/products">
            <li><i class="fa-solid fa-arrow-left"></i>back</li>
        </a>
        <div class="card">
            <h1>
                <%= product.name %>
            </h1>

            <p><strong>Id:</strong>
                <%= product.id %>
            </p>
            <p><strong>Category:</strong>
                <%= product.category %>
            </p>
            <p><strong>Active:</strong>
                <%= product.isActive %>
            </p>
            <p><strong>Description: </strong>
                <%= product.description %>
            </p>

            <h3>Brand</h3>
            <p><strong>Id:</strong>
                <a href="/brands/<%= product.brand.id %>">
                    <%= product.brand.id %>
                </a>
            </p>
            <p><strong>Founded: <%= product.brand.foundedYear %>
            </p>
            <p><strong>Premium: <%= product.brand.isPremium %>
            </p>
            <div class="detail-image">
                <img src="<%= product.brand.logoUrl %>" alt="<%= product.brand.name %>">
            </div>

            <a href="/products/<%= product.id %>/edit">Edit product</a>
        </div>
        <%- include("partials/footer") %>
</body>

</html>